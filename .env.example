ADMIN_USERNAME=admin
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
# Wrap bcrypt hashes in single quotes so Docker Compose does not expand `$` characters.
ADMIN_PASSWORD_HASH=''
SECRET_KEY=
COOKIE_SECURE=true
DATABASE_PATH=/data/longlivelatin.db
PORT=8000
# Host port used by Docker Compose. Change this without altering the container port.
APP_PORT=8200
# Use 127.0.0.1 when a reverse proxy runs on this host; use 0.0.0.0 for LAN access.
BIND_ADDRESS=0.0.0.0
